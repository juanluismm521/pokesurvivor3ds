# Servidor de relevo de PokéSurvivor 3DS (jugar online). Lo instala server/install.sh.
# Quitarlo: systemctl disable --now pokesurvivor-relay
[Unit]
Description=PokéSurvivor 3DS: servidor de relevo para jugar online (UDP 24873)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/pokesurvivor-relay/relay.py --port 24873
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=200M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
